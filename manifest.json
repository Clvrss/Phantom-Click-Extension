{
  "manifest_version": 3,
  "name": "Phantom Click",
  "version": "1.0.0",
  "version_name": "1.0.0 by Sherlock Holmes",
  "description": "Check a link before you click it. Shows a Safe, Warning or Risky badge beside links, with a plain-language explanation.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["rules.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["content.css"], "matches": ["http://*/*", "https://*/*"] }
  ],
  "action": {
    "default_title": "Phantom Click",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  }
}
